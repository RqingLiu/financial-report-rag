{"parent_id": "U01", "parent_family": "mu_product_economics", "parent_fact_ids": ["U01:f2"], "parent_group_indexes": [0, 1, 2, 8], "reference_selectors": [{"text": "核心技术类别为DRAM、NAND及其他（主要NOR）；HBM属于DRAM相关产品，不能与DRAM并列后重复加总。DRAM/NAND技术可跨客户市场分部销售。[MU26.986] [MU25.43] [MU25.44] [MU25.45] [MU25.46]"}], "source_release": "golden_v2", "review_status": "agent_curated_split_pending_human_review", "id": "U01.01", "parent_limit_indexes": [], "parent_error_indexes": [0], "numeric_check_ids": [], "depends_on": [], "reference_source_ids": ["MU25.43", "MU25.44", "MU25.45", "MU25.46", "MU26.986"], "additional_source_groups": []}
